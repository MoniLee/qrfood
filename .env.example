# Copy this file to .env and adjust values for your local setup.
HOST=0.0.0.0
PORT=3000
BASE_URL=
QR_PUBLIC_URL=

# Default XAMPP MySQL/MariaDB settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restaurant_system
DB_USER=root
DB_PASS=

GST_DEFAULT_RATE=18
MAX_UPLOAD_BYTES=2097152
SESSION_SECRET=replace-with-a-long-random-value
NODE_ENV=development
# Set TRUST_PROXY=true only when running behind a trusted reverse proxy.
TRUST_PROXY=false
