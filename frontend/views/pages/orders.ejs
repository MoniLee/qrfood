<%- include('../partials/head') %><% if (!minimalLayout) { %><div class="app-shell"><%- include('../partials/nav') %><% } %>
<main id="main-content" data-customer="<%= role === 'customer' ? '1' : '0' %>">
    <header class="page-header">
        <div>
            <h1 class="page-title">Orders</h1>
            <p class="page-sub"><%= role === 'customer' ? 'Your recent orders' : 'Track and update order status' %></p>
        </div>
        <div class="btn-group">
            <button type="button" class="btn btn-secondary btn-sm" id="btnRefreshOrders">Refresh</button>
            <% if (role !== 'customer') { %>
                <a class="btn btn-primary btn-sm" href="<%- e(appUrl('pos')) %>">New order</a>
            <% } %>
        </div>
    </header>

    <p class="text-muted mb-1" id="ordersSyncNote" aria-live="polite"></p>

    <div class="table-wrap table-cards-sm">
        <table class="data-table" id="ordersTable">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Type</th>
                    <th>Table / Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Time</th>
                    <th class="no-print">Actions</th>
                </tr>
            </thead>
            <tbody id="ordersBody">
                <% for (const o of orders || []) { %>
                    <tr data-order-id="<%= o.id %>">
                        <td data-label="Code"><strong><%- e(o.order_code) %></strong></td>
                        <td data-label="Type"><%- e(o.type) %></td>
                        <td data-label="Details">
                            <% if ((o.type ?? '') === 'DINE_IN') { %>
                                <%- e((o.table_label ?? '—')) %>
                            <% } else { %>
                                <%- e((o.customer_name ?? '')) %><br>
                                <span class="text-muted"><%- e((o.customer_phone ?? '')) %></span>
                            <% } %>
                        </td>
                        <td data-label="Status"><span class="badge <%- e('badge-' + o.status.replace(/[^a-z]/g, '')) %>"><%- e(o.status) %></span></td>
                        <td data-label="Total">₹<%= Number(o.total).toFixed(2) %></td>
                        <td data-label="Time" class="text-muted"><%- e(o.created_at) %></td>
                        <td data-label="Actions" class="no-print">
                            <div class="btn-group">
                                <a class="btn btn-outline btn-sm" href="<%- e(appUrl('invoice/' + o.id)) %>">Invoice</a>
                                <% if (role !== 'customer') { %>
                                <select class="form-select status-select btn-sm" style="min-width:120px;padding:0.35rem;" data-order-id="<%= o.id %>" aria-label="Update status for <%- e(o.order_code) %>">
                                    <% for (const st of ["pending", "preparing", "ready", "completed"]) { %>
                                        <option value="<%= st %>" <%= (o.status ?? '') === st ? 'selected' : '' %>><%= st === 'completed' ? ((o.type ?? '') === 'DELIVERY' ? 'delivered' : 'served') : st %></option>
                                    <% } %>
                                </select>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</main>
<%- include('../partials/footer') %>
